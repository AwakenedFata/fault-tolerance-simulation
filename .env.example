# ==============================================================================
# KONFIGURASI KREDENSIAL RABBITMQ
# ==============================================================================
# Salin file ini menjadi .env (sudah disediakan) lalu sesuaikan kredensial RabbitMQ Anda.
#
# CATATAN PENTING UNTUK DOCKER WORKER -> RABBITMQ DI HOST (WINDOWS):
# Secara default, user bawaan RabbitMQ ("guest") HANYA boleh login dari localhost/loopback.
# Koneksi dari Docker Container (via host.docker.internal) sering terdeteksi sebagai non-loopback
# sehingga ditolak (ACCESS_REFUSED).
# Sangat disarankan membuat user RabbitMQ khusus di host, misalnya:
#   rabbitmqctl add_user admin admin123
#   rabbitmqctl set_user_tags admin administrator
#   rabbitmqctl set_permissions -p / admin ".*" ".*" ".*"
# lalu isi RABBITMQ_USER dan RABBITMQ_PASS di bawah ini.

# --- Opsi 1: Konfigurasi Per Komponen (Direkomendasikan untuk RabbitMQ Lokal di Host) ---
# Producer di Host akan memakai RABBITMQ_HOST apa adanya (localhost).
# Consumer di dalam Docker akan OTOMATIS menerjemahkan localhost/127.0.0.1 -> host.docker.internal.
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ISI_USERNAME_RABBITMQ_ANDA
RABBITMQ_PASS=ISI_PASSWORD_RABBITMQ_ANDA
RABBITMQ_VHOST=/

# --- Opsi 2: URL Lengkap (Opsional, misal untuk CloudAMQP / Server Remote) ---
# Jika diisi (contoh: amqps://user:pass@host.rmq.cloudamqp.com/vhost),
# variabel ini akan mengoverride Opsi 1 di atas. Biarkan kosong jika memakai Opsi 1.
RABBITMQ_URL=

# ==============================================================================
# KONFIGURASI QUEUE & FAULT TOLERANCE
# ==============================================================================
# Nama queue (durable: true)
QUEUE_NAME=krs_pemesanan_queue

# Single Active Consumer (SAC):
# true  = Consumer 1 menangani SEMUA pesan; Consumer 2 standby dan langsung mengambil alih
#         sisa pesan (termasuk yang belum di-ACK) begitu Consumer 1 mati (sesuai Hint.jpeg).
# false = Round-Robin (Consumer 1 dan Consumer 2 memproses paralel secara bergantian).
# PERHATIAN: Jika mengubah nilai ini setelah queue terlanjur dibuat di RabbitMQ,
# hapus dulu queue lama di RabbitMQ Management UI atau ubah QUEUE_NAME agar tidak 406 PRECONDITION_FAILED.
SINGLE_ACTIVE_CONSUMER=true

# Fair dispatch: jumlah maksimal pesan unacked yang diambil worker per waktu
PREFETCH_COUNT=1

# Heartbeat koneksi AMQP (detik) agar deteksi gangguan koneksi lebih cepat
RABBITMQ_HEARTBEAT=10

# Interval percobaan reconnect (ms) saat RabbitMQ dihentikan sementara (Skenario 4 & 5)
RECONNECT_INTERVAL_MS=3000

# ==============================================================================
# KONFIGURASI SIMULASI PEMROSESAN & PENGUJIAN
# ==============================================================================
# Durasi simulasi pemrosesan per pesan (ms). 4000ms (4 detik) memberi jeda nyaman
# untuk mematikan Consumer 1 di tengah proses sebelum ACK saat demo.
PROCESS_DELAY_MS=4000

# Jeda singkat (ms) antara commit data (idempotency store) dan pengiriman ACK.
# Berguna untuk memahami jendela rawan crash pasca-commit sebelum ACK.
PRE_ACK_DELAY_MS=500

# Jumlah default pesan yang dikirim Producer (sesuai PDF 3C: 10 pesan)
MESSAGE_COUNT=10

# Lokasi penyimpanan state idempotency (di Docker otomatis diarahkan ke /app/data/processed)
IDEMPOTENCY_DIR=./data/processed
